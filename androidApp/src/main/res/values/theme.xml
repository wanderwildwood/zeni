<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Green" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="Theme.Green.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Green</item>
        <!-- No start-up window: in dark mode it would flash white before the first frame. -->
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>